# Ralph workspace config. Recarregado antes de CADA iteração (live reload).
# Edite mid-run para mudar tool/model/memory sem matar o loop.
# CLI flags (--tool) só definem o default inicial se este arquivo não existir.

RALPH_TOOL=claude

# O default vem de ~/.codex/config.toml quando disponível.
# RALPH_CODEX_MODEL=gpt-4o
# RALPH_CODEX_EFFORT=high

# Defaults do Grok CLI.
# RALPH_GROK_MODEL=grok-4.6
# RALPH_GROK_EFFORT=high

# true|false — se a iteração sair non-zero por quota, rotaciona RALPH_TOOL
RALPH_SWITCH_ON_EXHAUSTION=true

# Cap de RAM do processo do agente (systemd-run --user --scope). Vazio = desliga.
# Ex.: 8G, 512M, 50%
RALPH_MEMORY_MAX=8G

# full = parser jq de streams (default) | simple = só tee no log
RALPH_STREAM=full

# Logs a reter em .ralph/<ws>/logs (default min(max_iterations, 50) se vazio)
# RALPH_LOOP_MAX_LOGS=50

# Falhas genéricas consecutivas antes de interromper o loop.
RALPH_MAX_CONSECUTIVE_FAILURES=3
